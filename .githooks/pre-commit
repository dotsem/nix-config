#!/usr/bin/env bash
set -euo pipefail

# master git pre-commit hook
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "🔍 Running pre-commit validation checks..."

# 1. auto-encrypt and verify sops secret files
if [[ -f "$REPO_ROOT/scripts/git/pre-commit-encrypt-secrets.sh" ]]; then
  bash "$REPO_ROOT/scripts/git/pre-commit-encrypt-secrets.sh"
else
  echo "Pre-commit encryption script not found!"
  exit 1
fi

# 2. verify hosts.env is synchronized with lib/hosts.nix
if [[ -f "$REPO_ROOT/scripts/git/pre-commit-check-hosts.sh" ]]; then
  bash "$REPO_ROOT/scripts/git/pre-commit-check-hosts.sh"
else
  echo "Pre-commit check hosts script not found!"
  exit 1
fi

echo "✅ All pre-commit checks passed successfully!"
